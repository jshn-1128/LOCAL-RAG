# Application
APP_NAME=local-rag
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Vector Store
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=data/vector_store

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
