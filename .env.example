# ── Local RAG — Environment Configuration ─────────────────────────────────
# All settings use the LOCAL_RAG_ prefix.
# Copy this file to .env and adjust values as needed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   # Run the application — settings load automatically


# ── Application ───────────────────────────────────────────────────────────
LOCAL_RAG_APP_NAME=Local RAG
LOCAL_RAG_ENVIRONMENT=development
LOCAL_RAG_LOG_LEVEL=DEBUG


# ── API Server ────────────────────────────────────────────────────────────
LOCAL_RAG_API_HOST=0.0.0.0
LOCAL_RAG_API_PORT=8000


# ── HTTP Middleware ───────────────────────────────────────────────────────
# LOCAL_RAG_ALLOWED_HOSTS=["*"]
# LOCAL_RAG_CORS_ORIGINS=["*"]
# LOCAL_RAG_CORS_METHODS=["*"]
# LOCAL_RAG_CORS_HEADERS=["*"]
# LOCAL_RAG_CORS_ALLOW_CREDENTIALS=true
# LOCAL_RAG_CORS_MAX_AGE=600
# LOCAL_RAG_REQUEST_ID_HEADER=X-Request-ID
# LOCAL_RAG_PROCESS_TIME_HEADER=X-Process-Time
# LOCAL_RAG_TRUSTED_PROXY_SUPPORT=false


# ── LLM / Ollama ─────────────────────────────────────────────────────────
LOCAL_RAG_LLM_HOST=http://localhost:11434
LOCAL_RAG_LLM_MODEL=llama3.2
LOCAL_RAG_LLM_TEMPERATURE=0.7
LOCAL_RAG_LLM_MAX_TOKENS=2048
LOCAL_RAG_LLM_REQUEST_TIMEOUT=120


# ── Embeddings ────────────────────────────────────────────────────────────
LOCAL_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_RAG_EMBEDDING_DIMENSIONS=384
LOCAL_RAG_EMBEDDING_DEVICE=auto


# ── Vector Store ──────────────────────────────────────────────────────────
LOCAL_RAG_VECTOR_STORE_TYPE=chroma
LOCAL_RAG_VECTOR_STORE_COLLECTION=documents


# ── Document Ingestion ────────────────────────────────────────────────────
LOCAL_RAG_MAX_FILE_SIZE_MB=50


# ── Document Processing / Chunking ─────────────────────────────────
LOCAL_RAG_CHUNK_SIZE=512
LOCAL_RAG_CHUNK_OVERLAP=64


# ── Retrieval ─────────────────────────────────────────────────────────────
LOCAL_RAG_TOP_K=4


# ── Conversation Memory ───────────────────────────────────────────────────
LOCAL_RAG_MEMORY_MAX_HISTORY=20
